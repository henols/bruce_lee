# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
# NB: *.a is deliberately NOT ignored here - ACME uses .a for 6502 source files
# (see its docs: "Please use '.a' as the file name extension of ACME source
# code files"), so ignoring it would silently drop assembly sources.
*.lib
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# debug information files
*.dwo

# Claude Code state staged for the first devcontainer rebuild (contains credentials)
.devcontainer/.claude-seed/

# Claude Code: track this project's own skills, ignore the installed toolkit
# (agents, commands, hooks, gsd-core and local settings are per-machine)
.claude/*
!.claude/skills/

# scratch notes
anything.*

# transient VICE probe screenshots (evidence is re-captured by tools/recover.mjs)
recovery/*/dumps/probe-*.png

# host-side VICE supervisor output (tools/vice-supervisor.sh): crash logs and
# the restart epoch file, regenerated fresh on every supervisor start -- not
# a project artifact, just evidence for the current debugging session.
.vice-supervisor/

# deployed copies of .claude/skills/vice-session/resources/ -- the tracked
# source of truth lives in the skill; these are regenerated automatically by
# install-resources.mjs the first time any vice-session .mjs entry point
# runs, and are disposable: never hand-edit them here (edit resources/
# instead), and a real host setup keeps working exactly as before because
# they still land at these same paths.
/tools/vice-supervisor.sh
/tools/vice-pool.sh
/tools/lib/container-guard.sh
/tools/lib/repo-root.sh
